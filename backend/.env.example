# Nepal Cricket Hub backend environment
# Copy to .env and fill in real values.

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Supabase ---
# Public anon key is safe for the browser; the service role key is SERVER-SIDE ONLY.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- External cricket API ---
# Set provider to "sample" for offline development, or "http" to connect a real
# cricket API (CricAPI-style REST endpoints). The HttpCricketProvider maps generic
# endpoints; adjust the URL/response mapping in src/services/providers/HttpCricketProvider.ts.
CRICKET_PROVIDER=sample
CRICKET_API_BASE_URL=
CRICKET_API_KEY=

# --- News / RSS ---
# Newline-separated RSS feed URLs used by the news aggregator (optional, admin can
# manage sources via the admin panel too).
NEWS_RSS_FEEDS=https://example.com/feed.xml

# --- Scheduling (cron expressions) ---
CRON_CRICKET=*/2 * * * *
CRON_NEWS=*/10 * * * *
CRON_CLEANUP=0 * * * *

# --- Data retention ---
API_LOG_RETENTION_DAYS=14

# --- Admin bootstrap (optional) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
