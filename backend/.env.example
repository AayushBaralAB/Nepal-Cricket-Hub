# Nepal Cricket Hub backend environment
# Copy to .env and fill in real values.

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- MongoDB ---
# Connection string for MongoDB (local or Atlas). Example (local):
# MONGO_URL=mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=nepal_cricket_hub

# --- Admin API ---
# Shared bearer token for the /api/admin endpoints. Paste this value into the
# admin dashboard's "Admin API token" field.
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# --- External cricket API ---
# provider options:
#   "sample"  -> offline dev data (no API needed)
#   "cricapi" -> CricAPI v1 (https://api.cricapi.com) — set CRICKET_API_KEY
#   "http"    -> generic REST adapter (HttpCricketProvider)
CRICKET_PROVIDER=sample
CRICKET_API_BASE_URL=
CRICKET_API_KEY=

# --- News / RSS ---
# Newline-separated RSS feed URLs used by the news aggregator (optional, admin can
# manage sources via the admin panel too).
NEWS_RSS_FEEDS=https://example.com/feed.xml

# --- Scheduling (cron expressions) ---
# The free CricAPI plan allows only 100 hits/day, so the full sync is throttled
# to every 6 hours and a cheap live-score refresh runs every 2 hours. Adjust to
# your plan's hit limit (hitsToday / hitsLimit is reported by the API).
CRON_CRICKET=0 */6 * * *
CRON_LIVE_REFRESH=30 */2 * * *
CRON_NEWS=*/10 * * * *
CRON_CLEANUP=0 * * * *

# --- Data retention ---
API_LOG_RETENTION_DAYS=14

# --- Admin bootstrap (optional) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
