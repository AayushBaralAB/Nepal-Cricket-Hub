# CricketHub frontend environment
# Copy to .env.local

# Backend API URL (no trailing slash, /api is appended automatically)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site URL (used for canonical links, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin login credentials for /login
NEXT_PUBLIC_ADMIN_USERNAME=crickethub.com
NEXT_PUBLIC_ADMIN_PASSWORD=crickethub.com
