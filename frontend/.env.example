# Nepal Cricket Hub frontend environment
# Copy to .env.local

# Base URL of the Nepal Cricket Hub backend REST API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Public site URL (used for canonical links, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=https://nepalcrickethub.com

# Supabase (client-side anon key — NEVER put the service role key here)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
