# CricketHub frontend environment
# Copy to .env.local

# Base URL of the CricketHub backend REST API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Public site URL (used for canonical links, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=https://crickethub.com

# Admin login credentials for /login (defaults to crickethub.com if unset)
NEXT_PUBLIC_ADMIN_USERNAME=crickethub.com
NEXT_PUBLIC_ADMIN_PASSWORD=crickethub.com
